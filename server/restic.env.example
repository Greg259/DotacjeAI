# Skopiuj do /opt/dotacje-ai/secrets/restic.env i ustaw chmod 600.
# Nie dodawaj prawdziwych wartości do Git.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/BUCKET_NAME
AWS_ACCESS_KEY_ID=UZUPELNIJ_LOKALNIE_NA_SERWERZE
AWS_SECRET_ACCESS_KEY=UZUPELNIJ_LOKALNIE_NA_SERWERZE
RESTIC_PASSWORD_FILE=/opt/dotacje-ai/secrets/restic-password
