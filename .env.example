APP_ENV=production
APP_VERSION=0.8.0
LOG_LEVEL=INFO
SESSION_DAYS=30
SESSION_COOKIE_SECURE=true
TERMS_VERSION=2026-09-26
SOURCE_STORAGE_ROOT=/data/source-snapshots
CRAWLER_USER_AGENT=DotacjeAI/0.3 (+https://dotacjeai.eu)
CRAWLER_TIMEOUT_SECONDS=30
CRAWLER_RETRIES=3
CRAWLER_MAX_RESPONSE_BYTES=26214400
CRAWLER_EXTRA_CA_PATH=/app/certs/homepl-ov-tls-g2-r35-ca.pem
POSTGRES_DB=dotacje
POSTGRES_USER=dotacje
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=CHANGE_ME_WITH_CADDY_HASH_PASSWORD
LLM_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
LLM_MODEL_FAST=openai/gpt-6-luna
LLM_MODEL_STRONG=openai/gpt-6-luna-pro
LLM_MODEL_VALIDATOR=openai/gpt-6-luna
LLM_DAILY_BUDGET_USD=1
LLM_WARNING_BUDGET_USD=5
LLM_CRITICAL_BUDGET_USD=8
LLM_MONTHLY_BUDGET_USD=10
LLM_TIMEOUT_SECONDS=60
LLM_MAX_SOURCE_CHARACTERS=60000
